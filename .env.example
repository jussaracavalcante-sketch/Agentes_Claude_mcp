# ─── Banco de dados ────────────────────────────────────────────────────────────
POSTGRES_USER=vkb
POSTGRES_PASSWORD=vkb
POSTGRES_DB=vkb
# Deixe em branco para usar SQLite local (apps/api/vkb.db)
DATABASE_URL=postgresql+psycopg://vkb:vkb@localhost:5432/vkb

# ─── Aplicação ─────────────────────────────────────────────────────────────────
VKB_ENV=development
VKB_SECRET_KEY=troque-esta-chave-em-producao
VKB_ACCESS_TOKEN_TTL_MIN=480
VKB_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Tenant e usuário criados pelo seed
VKB_SEED_TENANT=vanguarda
VKB_SEED_ADMIN_EMAIL=admin@vanguardamartech.com.br
VKB_SEED_ADMIN_PASSWORD=vanguarda

# ─── LLM Gateway ───────────────────────────────────────────────────────────────
# Credenciais são gravadas cifradas na tabela llm_credentials.
# Estas variáveis servem apenas para bootstrap em desenvolvimento.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ─── Front-end ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
