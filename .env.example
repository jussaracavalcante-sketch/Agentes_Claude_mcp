# ─── Banco de dados ────────────────────────────────────────────────────────────
POSTGRES_USER=vkb
POSTGRES_PASSWORD=vkb
POSTGRES_DB=vkb
# Deixe em branco para usar SQLite local (apps/api/vkb.db)
DATABASE_URL=postgresql+psycopg://vkb:vkb@localhost:5432/vkb

# ─── Aplicação ─────────────────────────────────────────────────────────────────
VKB_ENV=development
VKB_SECRET_KEY=troque-esta-chave-em-producao
VKB_ACCESS_TOKEN_TTL_MIN=480
# Origens do navegador autorizadas a chamar a API diretamente.
# No docker-compose o console e servido pelo nginx na MESMA origem da API
# (o nginx faz proxy de /api), entao esta lista nao e usada nesse caminho.
# Ela importa quando o front roda em outra origem: `make web` (5173),
# `vite preview` (4173) ou um host proprio. `localhost` e `127.0.0.1` sao
# origens diferentes para o navegador — mantenha as duas.
VKB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8080,http://127.0.0.1:8080

# Tenant e usuário criados pelo seed
VKB_SEED_TENANT=vanguarda
VKB_SEED_ADMIN_EMAIL=admin@vanguardamartech.com.br
VKB_SEED_ADMIN_PASSWORD=vanguarda

# ─── LLM Gateway ───────────────────────────────────────────────────────────────
# Credenciais são gravadas cifradas na tabela llm_credentials.
# Estas variáveis servem apenas para bootstrap em desenvolvimento.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ─── Front-end ─────────────────────────────────────────────────────────────────
# Deixe VAZIO para o console usar caminho relativo (/api/v1/...), que e o modo
# do docker-compose e do `make web`. Preencha somente se o front for servido
# de um host que nao faz proxy para a API.
VITE_API_URL=
